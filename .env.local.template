# Environment Configuration Template
# Copy this file to .env.local and fill in your actual values

# Site Configuration
# Canonical production URL (www — Vercel primary domain). Used for metadata, sitemap, robots, JSON-LD.
NEXT_PUBLIC_SITE_URL=https://www.vantixstrategies.com
NEXT_PUBLIC_SITE_NAME="Vantix Strategies"

# Contact Information
NEXT_PUBLIC_CONTACT_EMAIL=hello@consulting.com
NEXT_PUBLIC_CONTACT_PHONE=+1-555-123-4567

# Analytics (Optional)
# NEXT_PUBLIC_GA_ID=your-google-analytics-id

# Form Submission (Optional - for services like Formspree, Netlify Forms, etc.)
# FORM_ENDPOINT=https://formspree.io/f/YOUR_FORM_ID

# API Keys (Server-side only)
# Add any server-side API keys here
# OPENAI_API_KEY=your-openai-key

# Contact Form Email Delivery (Server-side only)
CONTACT_TO_EMAIL=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
# Must be different from CONTACT_TO_EMAIL
SMTP_FROM=
